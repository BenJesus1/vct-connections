# Clerk publishable key from https://dashboard.clerk.com → API keys
# Enable Google under SSO connections (development uses Clerk's shared credentials).
VITE_CLERK_PUBLISHABLE_KEY=

# Supabase (Project Settings → Data API / API Keys). Publishable key only — never the service role.
# Use the project URL (https://xxxx.supabase.co) — do not append /rest/v1/.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
